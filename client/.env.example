# Bora! App - Configurações de Ambiente do Frontend (Client)

# Endpoint da API REST do Backend
VITE_API_URL=http://localhost:3333/api/v1

# Opcional: Chave da Google Maps Platform (Maps JavaScript API, Places API, Geocoding API)
# Se preenchida, o Bora! App utiliza nativamente o Google Maps; se vazia, utiliza o Leaflet/OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
